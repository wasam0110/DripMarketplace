# Public browser configuration only. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api/v1
# Development proxy target; this is not bundled into browser JavaScript.
API_PROXY_TARGET=http://127.0.0.1:8000
# Enable only after Google OAuth credentials and same-host callback URLs are configured.
VITE_ENABLE_GOOGLE_AUTH=false
# Keep disabled until provider/configuration integration checks pass. Public values only.
VITE_ENABLE_PAYFAST=false
VITE_PAYFAST_ENVIRONMENT=sandbox
# Must match API_BASE_URL used by the backend's generated callback (origin only).
VITE_PAYFAST_CALLBACK_ORIGIN=http://127.0.0.1:8000
