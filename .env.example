# DRIP Backend — development environment
# Copy to .env and replace secrets/URLs before running the API.

ENVIRONMENT=development
APP_NAME=DRIP API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=true

ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/drip
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0

# RS256 JWT
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Put the PEM values below using literal \n between lines.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PRODUCTS=products
SUPABASE_STORAGE_BUCKET_BRANDS=brands
SUPABASE_STORAGE_BUCKET_INVOICES=invoices

# JazzCash
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform

# Easypaisa
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=https://easypaystg.easypaisa.com.pk

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=pkr

# Resend
RESEND_API_KEY=
FROM_EMAIL=orders@drip.pk
FROM_NAME=DRIP Marketplace

# WhatsApp
DRIP_WHATSAPP_NUMBER=92308306241

# Business rules
COMMISSION_RATE=0.15
REGISTRATION_FEE=5000
BASE_SLOTS=50
EXTRA_SLOT_PRICE=50
FREE_SHIPPING_THRESHOLD=5000
STANDARD_SHIPPING_FEE=200
COD_TIMEOUT_MINUTES=30
WALLET_HOLD_DAYS=3
MIN_WITHDRAWAL_AMOUNT=500
MAX_WITHDRAWAL_AMOUNT=200000
MAX_COD_ORDER_AMOUNT=25000

# Monitoring
SENTRY_DSN=
