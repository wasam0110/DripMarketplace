# WearHowZ Backend — development environment
# Copy to .env and fill in values before running.

ENVIRONMENT=development
APP_NAME=WearHowZ API
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=true

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL — matches docker-compose.yml; use your own URL for hosted databases
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/drip
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6379/0

# RS256 JWT
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PRODUCTS=products
SUPABASE_STORAGE_BUCKET_BRANDS=brands
SUPABASE_STORAGE_BUCKET_INVOICES=invoices

# PayFast Pakistan
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_SANDBOX=true
# Keep false until the legacy adapter is verified against your merchant guide.
PAYFAST_ENABLED=false

# App URLs (used for PayFast return/IPN urls)
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Email — Resend
RESEND_API_KEY=
FROM_EMAIL=orders@example.com
FROM_NAME=WearHowZ

# WhatsApp
DRIP_WHATSAPP_NUMBER=923208306241

# Business rules
COMMISSION_RATE=0.15
REGISTRATION_FEE=5000
BASE_SLOTS=50
EXTRA_SLOT_PRICE=50
FREE_SHIPPING_THRESHOLD=5000
STANDARD_SHIPPING_FEE=200
COD_TIMEOUT_MINUTES=30
PAYMENT_TIMEOUT_MINUTES=30
WALLET_HOLD_DAYS=3
MIN_WITHDRAWAL_AMOUNT=500
MAX_WITHDRAWAL_AMOUNT=200000
MAX_COD_ORDER_AMOUNT=25000

# Monitoring
SENTRY_DSN=

# Google: register API_BASE_URL/api/v1/auth/google/callback as redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GUEST_ORDER_TOKEN_DAYS=7
